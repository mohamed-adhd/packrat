<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="packrat.Views.MainWindow"
        Title="Sign in"
        Width="460" Height="640"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

  <Window.Resources>
    <SolidColorBrush x:Key="Orange">#FF6A00</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeHover">#FF8A33</SolidColorBrush>
    <SolidColorBrush x:Key="OrangePressed">#D95800</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#111111</SolidColorBrush>
    <SolidColorBrush x:Key="Field">#1A1A1A</SolidColorBrush>
    <SolidColorBrush x:Key="Line">#2E2E2E</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#9A9A9A</SolidColorBrush>
  </Window.Resources>

  <Window.Styles>

    <!-- Text fields: dark fill, orange border on focus -->
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="{StaticResource Orange}"/>
      <Setter Property="SelectionBrush" Value="#99FF6A00"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Orange}"/>
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#6A6A6A"/>
    </Style>

    <!-- Field labels -->
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#D6D6D6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <!-- Primary orange button -->
    <Style Selector="Button.primary">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="50"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Orange}"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrangeHover}"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrangePressed}"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <!-- Inline text link button -->
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Orange}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource OrangeHover}"/>
      <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource OrangePressed}"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="*,Auto">

    <!-- Main content -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <Border Margin="28,32,28,16"
              MaxWidth="400"
              VerticalAlignment="Center"
              Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}"
              BorderThickness="1"
              CornerRadius="14"
              ClipToBounds="True">

        <Grid RowDefinitions="Auto,*">

          <!-- Orange signature bar -->
          <Border Grid.Row="0" Height="6" Background="{StaticResource Orange}"/>

          <StackPanel Grid.Row="1" Margin="32,32,32,32" Spacing="0">

            <TextBlock Text="Welcome back"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="ExtraBold"/>
            <TextBlock Text="Sign in to continue to your account."
                       Foreground="{StaticResource Muted}"
                       FontSize="14"
                       Margin="0,6,0,28"
                       TextWrapping="Wrap"/>

            <!-- Email -->
            <TextBlock Classes="label" Text="Email"/>
            <TextBox x:Name="EmailBox"
                     Watermark="you@example.com"/>

            <!-- Password -->
            <TextBlock Classes="label" Text="Password" Margin="2,18,0,6"/>
            <TextBox x:Name="PasswordBox"
                     PasswordChar="●"
                     Watermark="Enter your password"/>

            <!-- Login -->
            <Button x:Name="LoginButton"
                    Classes="primary"
                    Content="Log in"
                    Margin="0,28,0,0"/>

            <!-- Sign up -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="0,22,0,0">
              <TextBlock Text="Don't have an account?"
                         Foreground="{StaticResource Muted}"
                         FontSize="14"
                         VerticalAlignment="Center"/>
              <Button x:Name="SignUpButton"
                      Classes="link"
                      Content="Sign up"/>
            </StackPanel>

          </StackPanel>
        </Grid>
      </Border>
    </ScrollViewer>

    <!-- Footer -->
    <TextBlock Grid.Row="1"
               Text="made by mohamed-adhd"
               Foreground="{StaticResource Orange}"
               Opacity="0.85"
               FontSize="12"
               HorizontalAlignment="Center"
               Margin="0,0,0,18"/>

  </Grid>
</Window>
